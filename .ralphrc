# .ralphrc — Ralph project configuration for Eatit Phase 3

PROJECT_NAME="eatit"
PROJECT_TYPE="typescript"    # monorepo; desktop side is TS, backend is Python

# Loop settings
MAX_CALLS_PER_HOUR=100
CLAUDE_TIMEOUT_MINUTES=20
CLAUDE_OUTPUT_FORMAT="json"

# Tool permissions — Claude needs to run compound commands (cd X && git ...),
# `git -C <path>` forms, and a broad set of git subcommands. Claude Code's
# prefix matcher doesn't split compounds, so exhaustive allow-listing of
# specific invocations is impractical; we widen to Bash(*).
# The prompt still forbids destructive moves (PROMPT.md "protected paths"
# + phase3-constraints.md "engineering discipline"), and every section
# must commit, giving us a trivial rollback path.
ALLOWED_TOOLS="Write,Read,Edit,Grep,Glob,Bash(*)"

# Session
SESSION_CONTINUITY=true
SESSION_EXPIRY_HOURS=24

# Task sources — fully local; the backlog lives in .ralph/fix_plan.md
TASK_SOURCES="local"

# Circuit breaker
CB_NO_PROGRESS_THRESHOLD=3
CB_SAME_ERROR_THRESHOLD=5
CB_OUTPUT_DECLINE_THRESHOLD=70
CB_COOLDOWN_MINUTES=30
CB_AUTO_RESET=false

# Misc
CLAUDE_AUTO_UPDATE=false   # we don't want the loop to silently update CLI mid-run
RALPH_VERBOSE=false
